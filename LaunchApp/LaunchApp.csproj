<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <WasmEnableSIMD>false</WasmEnableSIMD>
    <PublishTrimmed>false</PublishTrimmed>
    
    <RunAOTCompilation>false</RunAOTCompilation>
    <UseBlazorWebAssembly>true</UseBlazorWebAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="LumexUI" Version="2.4.0" />
    <PackageReference Include="Masa.Blazor" Version="1.7.7" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup><ProjectReference Include="../WebLaunch.Core/WebLaunch.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Content Remove="wwwroot/css/lumex.generated.css" />
    <Content Include="wwwroot/css/lumex.generated.css" />
  </ItemGroup>
  <Target Name="BuildLumexStyles" BeforeTargets="PrepareForBuild">
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
