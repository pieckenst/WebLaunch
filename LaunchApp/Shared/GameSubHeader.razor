@if (IsVisible) { <nav aria-label="Game sections">@foreach (var link in NavigationLinks) { <a href="@link.Url" aria-current="@(link.IsActive ? "location" : null)">@link.Text</a> }</nav> }
@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public List<LaunchApp.Models.NavLink> NavigationLinks { get; set; } = [];
}
