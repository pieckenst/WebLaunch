@inherits LayoutComponentBase
@inject LaunchApp.Services.GameNavigation GameNavigation
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject MasaBlazor Masa
@implements IAsyncDisposable

@if (navigationFailed)
{
    <section class="app-recovery" role="alert">
        <h1>Let’s reload the launcher</h1>
        <p>Navigation could not finish safely. Reload, then reconnect your desktop launcher. Sign-in details are not saved.</p>
        <button type="button" @onclick="ReloadLauncher">Reload launcher</button>
        <a href="@Navigation.BaseUri" @onclick="ReturnToLibrary" @onclick:preventDefault>Return to game library</a>
    </section>
}
else
{
<MApp Dark="@dark">
    <a class="skip-link" href="@(Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0] + "#main")">Skip to content</a>
    <LumexNavbar Class="site-header" Height="auto" Blurred="false" Classes="@(new NavbarSlots { Wrapper = "main-nav-content" })">
        <LumexNavbarContent As="div" Class="brand-group">
            <LumexNavbarBrand><LumexLink Class="brand" Href="./" Color="LumexUI.Common.ThemeColor.None"><svg aria-hidden="true" width="26" height="26" viewBox="0 0 32 32" fill="currentColor"><path d="M17.648 10.13 15.879 7.026 7.03 22.55h3.498ZM19.88 14.046l-1.77 3.152 1.284 2.253h-2.549l-1.743 3.099h9.625Z" /></svg>Game Launcher</LumexLink></LumexNavbarBrand>
        </LumexNavbarContent>
        <LumexNavbarContent Class="main-links">
            <LumexNavbarItem><LumexLink Href="./" Color="LumexUI.Common.ThemeColor.None"><NavigationIcon Name="overview" /> Home</LumexLink></LumexNavbarItem>
            <LumexNavbarItem><LumexLink Href="counter" Color="LumexUI.Common.ThemeColor.None" aria-current="@(GameNavigation.Route == "counter" ? "page" : null)">Final Fantasy XIV</LumexLink></LumexNavbarItem>
            <LumexNavbarItem><LumexLink Href="spellborn" Color="LumexUI.Common.ThemeColor.None" aria-current="@(GameNavigation.Route == "spellborn" ? "page" : null)">Spellborn</LumexLink></LumexNavbarItem>
        </LumexNavbarContent>
        <LumexNavbarContent Class="theme-control">
            <LumexNavbarItem><LumexSwitch tabindex="-1" Class="theme-toggle" Value="@dark" ValueChanged="SetTheme" Size="LumexUI.Common.Size.Small">Dark theme</LumexSwitch></LumexNavbarItem>
            <LumexNavbarItem><a class="nav-launch" href="@(GameNavigation.Route is { } route ? route + "#launch" : "./")">Launch Game</a></LumexNavbarItem>
        </LumexNavbarContent>
    </LumexNavbar>
    @if (GameNavigation.Route is not null)
    {
        <SectionTabBar Route="@GameNavigation.Route" Sections="@GameNavigation.Sections" ActiveSection="@GameNavigation.ActiveSection">
            <Menu>
                <a href="https://github.com/pieckenst/WebLaunch/releases/">Download desktop launcher</a>
                <a href="@(GameNavigation.Route + "#launch")">Pairing and desktop mode</a>
            </Menu>
        </SectionTabBar>
    }
    <main id="main" tabindex="-1">@Body</main>
    <footer>WebLaunch requires the Windows desktop launcher to start games. <a href="https://github.com/pieckenst/WebLaunch/releases/">Downloads</a></footer>
</MApp>
}

@code {
    private bool dark;
    private bool navigationFailed;
    private DotNetObjectReference<MainLayout>? reference;
    private bool syncNavigation = true;
    private IJSObjectReference? navigationModule;
    private IJSObjectReference? module;
    protected override void OnInitialized()
    {
        GameNavigation.Changed += Update;
        reference = DotNetObjectReference.Create(this);

    }
    private long lastBrowserLocationRevision;

    [JSInvokable]
    public void BrowserLocationChanged(string location, long revision)
    {
        // Click/hash/popstate reports cross the JS interop boundary asynchronously. Ignore any
        // late callback that predates a newer browser location and would otherwise reselect an old tab.
        if (revision <= lastBrowserLocationRevision) return;
        lastBrowserLocationRevision = revision;
        GameNavigation.RefreshLocation(location);
    }
    private void Update()
    {
        syncNavigation = true;
        if (!navigationFailed) _ = InvokeAsync(StateHasChanged);
    }

    private void ReloadLauncher() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    private void ReturnToLibrary() => Navigation.NavigateTo(Navigation.BaseUri, forceLoad: true);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/bridge.js"); }
            catch (Microsoft.JSInterop.JSException ex) { BrowserDiagnostics.Report("bridge module initialization", ex); }

            try { navigationModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/navigation.js"); }
            catch (Microsoft.JSInterop.JSException ex)
            {
                BrowserDiagnostics.Report("navigation module initialization", ex);
                navigationFailed = true;
                StateHasChanged();
                return;
            }

            if (module is not null)
            {
                try
                {
                    var preference = await module.InvokeAsync<string?>("preference", "theme");
                    dark = await module.InvokeAsync<bool>("applyTheme", preference);
                    if (Masa.Theme.Dark != dark) Masa.ToggleTheme();
                }
                catch (Microsoft.JSInterop.JSException ex)
                {
                    // A failed preference/theme call must not replace the whole page with an error boundary.
                    BrowserDiagnostics.Report("theme initialization", ex);
                }
            }
            StateHasChanged();
        }

        if (syncNavigation)
        {
            syncNavigation = false;
            if (navigationModule is not null && reference is not null)
            {
                try { await navigationModule.InvokeVoidAsync("sync", GameNavigation.Route, GameNavigation.ActiveSection, reference); }
                catch (Microsoft.JSInterop.JSException ex)
                {
                    BrowserDiagnostics.Report("navigation synchronization", ex);
                    navigationFailed = true;
                    StateHasChanged();
                    return;
                }
            }
        }
    }

    private async Task SetTheme(bool enabled)
    {
        dark = enabled;
        if (Masa.Theme.Dark != dark) Masa.ToggleTheme();
        if (module is null) return;

        try { await module.InvokeVoidAsync("preference", "theme", dark ? "dark" : "light"); }
        catch (Microsoft.JSInterop.JSException ex) { BrowserDiagnostics.Report("theme preference", ex); }

        try { await module.InvokeVoidAsync("applyTheme", dark ? "dark" : "light"); }
        catch (Microsoft.JSInterop.JSException ex) { BrowserDiagnostics.Report("theme application", ex); }
    }

    public async ValueTask DisposeAsync()
    {
        GameNavigation.Changed -= Update;
        try
        {
            if (navigationModule is not null)
            {
                try { await navigationModule.InvokeVoidAsync("dispose"); }
                catch (Microsoft.JSInterop.JSException ex) { BrowserDiagnostics.Report("navigation disposal", ex); }
                finally
                {
                    try { await navigationModule.DisposeAsync(); }
                    catch (Microsoft.JSInterop.JSException ex) { BrowserDiagnostics.Report("navigation reference cleanup", ex); }
                    finally { navigationModule = null; }
                }
            }
        }
        finally
        {
            try
            {
                if (module is not null)
                {
                    try { await module.DisposeAsync(); }
                    catch (Microsoft.JSInterop.JSException ex) { BrowserDiagnostics.Report("bridge reference cleanup", ex); }
                    finally { module = null; }
                }
            }
            finally
            {
                reference?.Dispose();
                reference = null;
            }
        }
    }
}

