@inherits LayoutComponentBase
@inject LaunchApp.Services.GameNavigation GameNavigation
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject MasaBlazor Masa
@implements IAsyncDisposable

<MApp Dark="@dark">
    <a class="skip-link" href="@(Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0] + "#main")">Skip to content</a>
    <LumexNavbar Class="site-header" Height="auto" Blurred="false" Classes="@(new NavbarSlots { Wrapper = "main-nav-content" })">
        <LumexNavbarContent As="div" Class="brand-group">
            <LumexNavbarBrand><LumexLink Class="brand" Href="./" Color="LumexUI.Common.ThemeColor.None"><svg aria-hidden="true" width="26" height="26" viewBox="0 0 32 32" fill="currentColor"><path d="M17.648 10.13 15.879 7.026 7.03 22.55h3.498ZM19.88 14.046l-1.77 3.152 1.284 2.253h-2.549l-1.743 3.099h9.625Z" /></svg>Game Launcher</LumexLink></LumexNavbarBrand>
        </LumexNavbarContent>
        <LumexNavbarContent Class="main-links">
            <LumexNavbarItem><LumexLink Href="./" Color="LumexUI.Common.ThemeColor.None"><NavigationIcon Name="overview" /> Home</LumexLink></LumexNavbarItem>
            <LumexNavbarItem><LumexLink Href="counter" Color="LumexUI.Common.ThemeColor.None" aria-current="@(GameNavigation.Route == "counter" ? "page" : null)">Final Fantasy XIV</LumexLink></LumexNavbarItem>
            <LumexNavbarItem><LumexLink Href="spellborn" Color="LumexUI.Common.ThemeColor.None" aria-current="@(GameNavigation.Route == "spellborn" ? "page" : null)">Spellborn</LumexLink></LumexNavbarItem>
        </LumexNavbarContent>
        <LumexNavbarContent Class="theme-control">
            <LumexNavbarItem><LumexSwitch tabindex="-1" Class="theme-toggle" Value="@dark" ValueChanged="SetTheme" Size="LumexUI.Common.Size.Small">Dark theme</LumexSwitch></LumexNavbarItem>
            <LumexNavbarItem><a class="nav-launch" href="@(GameNavigation.Route is { } route ? route + "#launch" : "./")">Launch Game</a></LumexNavbarItem>
        </LumexNavbarContent>
    </LumexNavbar>
    @if (GameNavigation.Route is not null)
    {
        <SectionTabBar Route="@GameNavigation.Route" Sections="@GameNavigation.Sections" ActiveSection="@GameNavigation.ActiveSection">
            <Menu>
                <a href="https://github.com/pieckenst/WebLaunch/releases/">Download desktop launcher</a>
                <a href="@(GameNavigation.Route + "#launch")">Pairing and desktop mode</a>
            </Menu>
        </SectionTabBar>
    }
    <main id="main" tabindex="-1">@Body</main>
    <footer>WebLaunch requires the Windows desktop launcher to start games. <a href="https://github.com/pieckenst/WebLaunch/releases/">Downloads</a></footer>
</MApp>
@code {
    private bool dark;
    private DotNetObjectReference<MainLayout>? reference;
    private bool syncNavigation = true;
    private IJSObjectReference? navigationModule;
    private IJSObjectReference? module;
    protected override void OnInitialized()
    {
        GameNavigation.Changed += Update;
        reference = DotNetObjectReference.Create(this);

    }
    [JSInvokable] public void BrowserLocationChanged(string location) => GameNavigation.RefreshLocation(location);
    private void Update()
    {
        syncNavigation = true;
        _ = InvokeAsync(StateHasChanged);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/bridge.js");
            navigationModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/navigation.js");
            var preference = await module.InvokeAsync<string?>("preference", "theme");
            dark = await module.InvokeAsync<bool>("applyTheme", preference);
            if (Masa.Theme.Dark != dark) Masa.ToggleTheme();
            StateHasChanged();
        }
        if (syncNavigation && navigationModule is not null)
        {
            syncNavigation = false;
            await navigationModule.InvokeVoidAsync("sync", GameNavigation.Route, GameNavigation.ActiveSection, reference);
        }
    }
    private async Task SetTheme(bool enabled)
    {
        if (module is null) return;
        dark = enabled;
        if (Masa.Theme.Dark != dark) Masa.ToggleTheme();
        await module.InvokeVoidAsync("preference", "theme", dark ? "dark" : "light");
        await module.InvokeVoidAsync("applyTheme", dark ? "dark" : "light");
    }
    public async ValueTask DisposeAsync()
    {
        GameNavigation.Changed -= Update;
        if (navigationModule is not null) { await navigationModule.InvokeVoidAsync("dispose"); await navigationModule.DisposeAsync(); }
        if (module is not null) await module.DisposeAsync();
        reference?.Dispose();
    }
}
