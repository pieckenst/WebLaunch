@inherits LayoutComponentBase
@inject LaunchApp.Services.GameNavigation GameNavigation
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<MApp>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
        <a class="brand" href="./">WebLaunch</a>
        <nav aria-label="Main navigation"><a href="counter">Final Fantasy XIV</a><a href="spellborn">Spellborn</a></nav>
        <button type="button" @onclick="ToggleTheme" aria-label="Toggle dark theme" aria-pressed="@dark">@(dark ? "Light theme" : "Dark theme")</button>
    </header>
    @if (GameNavigation.Route is not null)
    {
        <nav class="section-nav" aria-label="Game sections">
            @foreach (var section in GameNavigation.Sections)
            {
                <a href="@(GameNavigation.Route + "#" + section.Id)" aria-current="@(active == section.Id ? "location" : null)">@section.Title</a>
            }
            <a href="@(GameNavigation.Route + "#launch")">Launch settings</a>
        </nav>
    }
    <main id="main" tabindex="-1">@Body</main>
    <footer>WebLaunch requires the Windows desktop launcher to start games. <a href="https://github.com/pieckenst/WebLaunch/releases/">Downloads</a></footer>
</MApp>
@code {
    private bool dark;
    private string active = "overview";
    private IJSObjectReference? module;
    protected override void OnInitialized()
    {
        GameNavigation.Changed += Update;
        Navigation.LocationChanged += LocationChanged;
    }
    private void Update() => InvokeAsync(StateHasChanged);
    private void LocationChanged(object? sender, LocationChangedEventArgs e)
    {
        active = new Uri(e.Location).Fragment.TrimStart('#');
        if (active.Length == 0) active = "overview";
        Update();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/bridge.js");
            var preference = await module.InvokeAsync<string?>("preference", "theme");
            dark = await module.InvokeAsync<bool>("applyTheme", preference);
            StateHasChanged();
        }
    }
    private async Task ToggleTheme()
    {
        if (module is null) return;
        dark = !dark;
        await module.InvokeVoidAsync("preference", "theme", dark ? "dark" : "light");
        await module.InvokeVoidAsync("applyTheme", dark ? "dark" : "light");
    }
    public void Dispose() { GameNavigation.Changed -= Update; Navigation.LocationChanged -= LocationChanged; }
}
