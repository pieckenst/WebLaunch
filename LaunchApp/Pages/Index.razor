@page "/"
@inject LaunchApp.Services.GameNavigation GameNavigation
<PageTitle>WebLaunch — your game library</PageTitle>
<section class="library"><p class="eyebrow">YOUR NEXT ADVENTURE</p><h1>Your game library</h1><p>Choose a game, connect your Windows launcher, and play.</p>
<div class="game-grid">
@foreach (var game in _games)
{
    <article class="game-card"><img src="@game.CoverImage" alt="" loading="lazy" /><div><h2>@game.Name</h2><p>@game.Description</p><a class="button" href="@game.Route">Open @game.Name</a></div></article>
}
</div></section>
@code {

    protected override void OnInitialized() => GameNavigation.Set(null);
    private List<GameInfo> _games = new()
    {
        new GameInfo 
        { 
            Name = "Final Fantasy XIV",
            Description = "Experience an epic MMORPG featuring a captivating story",
            ShortInfo = "Join millions of adventurers in Eorzea",
            Route = "counter",
            CoverImage = "https://img.finalfantasyxiv.com/lds/h/V/U5TjBZoXVbddg1ZB7H4k0fkYqo.jpg",
            Tags = new[] { "MMORPG", "Fantasy", "Story-Rich" }
        },
        new GameInfo
        {
            Name = "Chronicles of Spellborn",
            Description = "Enter a unique fantasy world with action combat",
            ShortInfo = "Discover ancient mysteries in a vast realm",
            Route = "spellborn",
            CoverImage = "https://www.mobygames.com/images/promo/l/123769-the-chronicles-of-spellborn-wallpaper.jpg",
            Tags = new[] { "Action RPG", "Fantasy", "PvP" }
        }
    };

    public class GameInfo
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string ShortInfo { get; set; } = "";
        public string Route { get; set; } = "";
        public string CoverImage { get; set; } = "";
        public string[] Tags { get; set; } = [];
    }
}
