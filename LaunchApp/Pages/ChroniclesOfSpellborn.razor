@page "/spellborn"
@page "/spellborn/{Section}"
@inject NavigationManager navigationManager
@inject IJSRuntime jsRuntime
@inject MasaBlazor MasaBlazor
@inherits GamePageBase

<PageTitle>Chronicles of Spellborn</PageTitle>

<MContainer Fluid>
    <GameHeader Title="Chronicles of Spellborn" Description="Explore a forgotten world with a different approach to combat." Route="spellborn" />
    <LaunchPanel Game="spellborn" Title="Chronicles of Spellborn" />
    <MRow Class="mt-6">
        <MCol Cols="12" Md="8">
            <MCard id="overview" Class="pa-6 mb-6">
                <div class="text-h4 mb-4">About Chronicles of Spellborn</div>
                <p class="text-body-1">
                    Enter a unique fantasy world where ancient technology meets magic. The Chronicles of Spellborn offers an innovative combat system and a rich, mysterious world to explore.
                </p>
            </MCard>

            <MCard Class="pa-6 mb-6">
                <div id="classes" class="text-h4 mb-4">Character Classes</div>
                <MRow>
                    <MCol Cols="12" Md="4">
                        <div class="text-h6 mb-2">Warrior</div>
                        <MList Dense>
                            <MListItem>
                                <MListItemTitle>Bloodwarrior</MListItemTitle>
                            </MListItem>
                            <MListItem>
                                <MListItemTitle>Defender</MListItemTitle>
                            </MListItem>
                            <MListItem>
                                <MListItemTitle>Wrathguard</MListItemTitle>
                            </MListItem>
                        </MList>
                    </MCol>
                    <MCol Cols="12" Md="4">
                        <div class="text-h6 mb-2">Rogue</div>
                        <MList Dense>
                            <MListItem>
                                <MListItemTitle>Shadowblade</MListItemTitle>
                            </MListItem>
                            <MListItem>
                                <MListItemTitle>Deathhand</MListItemTitle>
                            </MListItem>
                            <MListItem>
                                <MListItemTitle>Skinshifter</MListItemTitle>
                            </MListItem>
                        </MList>
                    </MCol>
                    <MCol Cols="12" Md="4">
                        <div class="text-h6 mb-2">Spellcaster</div>
                        <MList Dense>
                            <MListItem>
                                <MListItemTitle>Runemage</MListItemTitle>
                            </MListItem>
                            <MListItem>
                                <MListItemTitle>Ancestral Mage</MListItemTitle>
                            </MListItem>
                            <MListItem>
                                <MListItemTitle>Oracle</MListItemTitle>
                            </MListItem>
                        </MList>
                    </MCol>
                </MRow>
            </MCard>
        </MCol>
    </MRow>
</MContainer>


@code {
    protected override string GameRoute => "spellborn";
    protected override LaunchApp.Services.GameSection[] PageSections => [new("overview", "Overview"), new("classes", "Classes")];
}
